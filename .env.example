# Treeto Desktop - Environment Configuration
# Copy this file to .env and fill in your values.

# AssemblyAI - Real-time transcription
ASSEMBLYAI_API_KEY=

# Deepgram - Fallback transcription provider
DEEPGRAM_API_KEY=

# OpenAI - Callout generation, summaries, meeting prep
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Google Gemini - Alternative AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth - Calendar integration
GOOGLE_CLIENT_ID=
